{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Instalar dependencias",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install -r requirements.txt",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Smoke test whole-detection",
      "type": "shell",
      "command": "${command:python.interpreterPath} scripts/smoke_test_whole_detection.py",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Treinar baseline whole-detection",
      "type": "shell",
      "command": "${command:python.interpreterPath} scripts/treinar_baseline.py --epocas 5 --batch-size 32",
      "group": "build",
      "problemMatcher": []
    }
  ]
}
